{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "in-process",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(pnpm test:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(uv run:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Read(//**)",
      "Grep",
      "Glob",
      "WebSearch",
      "Bash(python3 tools/:*)",
      "Bash(uv run tools/:*)",
      "Bash(supabase --version)",
      "Bash(supabase projects:*)",
      "Bash(supabase db diff:*)",
      "Bash(supabase migration list:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(docker compose down:*)",
      "Bash(psql:*)",
      "Write(.env*)",
      "Write(**/migrations/**)",
      "Bash(python3 tools/*cost*:*)",
      "Write(workflows/**)",
      "Write(tools/**)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Read(.env)",
      "Read(**/*.pem)",
      "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/teammate-idle-gate.sh"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/task-completed-gate.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tool-cost-guard.sh"
          }
        ]
      }
    ]
  }
}